@startuml ActivityWeather
' Biểu đồ hoạt động — Xem thời tiết (Open-Meteo trực tiếp trên app)

skinparam dpi 130
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam wrapWidth 320

skinparam nodesep 95
skinparam ranksep 58
skinparam Padding 10

skinparam backgroundColor #FFFFFF

skinparam title {
  FontSize 17
  FontColor #111111
}

skinparam activity {
  BackgroundColor #F3F3F3
  BorderColor #222222
  FontColor #111111
  RoundCorner 16
  DiamondBackgroundColor #E0E0E0
  DiamondBorderColor #222222
}

skinparam activityDiamond {
  BackgroundColor #E0E0E0
  BorderColor #222222
}

skinparam arrow {
  Color #111111
}

skinparam activityStartColor #111111
skinparam activityEndColor #111111

scale max 1680 width

title **Biểu đồ hoạt động - Xem thời tiết**

start

:Chọn khu vực / thành phố trên giao diện;

:Ánh xạ tên → **tọa độ** (trong app);

:Gọi API **Open-Meteo** (HTTPS);

if (**Nhận dữ liệu OK?**) then (Không)
  :Thông báo lỗi mạng hoặc không có dữ liệu;
  stop
else (Có)
endif

:Hiển thị nhiệt độ, độ ẩm và **dự báo** các ngày;

stop

@enduml
